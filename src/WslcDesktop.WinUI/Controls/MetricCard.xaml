<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="WslcDesktop.Controls.MetricCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WslcDesktop.Controls"
    xmlns:vm="using:WslcDesktop.ViewModels">

    <Border Style="{StaticResource CardStyle}">
        <Grid RowSpacing="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource CardTitleStyle}" />
            <TextBlock Grid.Row="1" Text="{x:Bind Value, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Grid.Row="2" Text="{x:Bind Caption, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            <Grid Grid.Row="3" Height="96" Margin="0,10,0,0">
                <local:Sparkline Values="{x:Bind History, Mode=OneWay}" Visibility="{x:Bind HasHistory, Mode=OneWay}" />
                <TextBlock
                    Text="Not enough samples yet"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Visibility="{x:Bind vm:Bindings.CollapsedWhen(HasHistory), Mode=OneWay}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
