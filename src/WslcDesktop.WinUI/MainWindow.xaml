<?xml version="1.0" encoding="utf-8"?>

<Window
    x:Class="WslcDesktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WSLC Desktop">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="WSLC Desktop" IsPaneToggleButtonVisible="True" PaneToggleRequested="OnPaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.png" />
            </TitleBar.IconSource>
            <TitleBar.RightHeader>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,8,0" VerticalAlignment="Center">
                    <StackPanel
                        x:Name="AdministratorBadge"
                        Orientation="Horizontal"
                        Spacing="4"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        ToolTipService.ToolTip="Running as administrator: wslc gives this instance its own session and VM, with its own containers."
                        AutomationProperties.Name="Running as administrator">
                        <FontIcon Glyph="&#xEA18;" FontSize="14" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        <TextBlock Text="Administrator" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Ellipse x:Name="RuntimeDot" Width="8" Height="8" VerticalAlignment="Center" />
                    <TextBlock x:Name="RuntimeText" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                    <TextBlock Text="Live" Margin="12,0,0,0" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                    <ToggleSwitch
                        x:Name="LiveToggle"
                        MinWidth="0"
                        OnContent=""
                        OffContent=""
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Live updates (refresh every 3 seconds)"
                        AutomationProperties.Name="Live updates"
                        Toggled="OnLiveToggled" />
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            PaneDisplayMode="Left"
            OpenPaneLength="220"
            SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Tag="dashboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF246;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader Content="Runtime" />
                <NavigationViewItem Content="Containers" Tag="containers">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B8;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="ContainersBadge" Background="{ThemeResource SystemFillColorSolidNeutralBrush}" Visibility="Collapsed" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem Content="Images" Tag="images">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B9;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="ImagesBadge" Background="{ThemeResource SystemFillColorSolidNeutralBrush}" Visibility="Collapsed" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem Content="Volumes" Tag="volumes">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEDA2;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="VolumesBadge" Background="{ThemeResource SystemFillColorSolidNeutralBrush}" Visibility="Collapsed" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem Content="Networks" Tag="networks">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE968;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="NetworksBadge" Background="{ThemeResource SystemFillColorSolidNeutralBrush}" Visibility="Collapsed" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="WSL containers" Tag="wslc">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE950;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="WSL" Tag="wsl">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE756;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Border x:Name="PageHost">
                    <Border.ChildTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="16" />
                        </TransitionCollection>
                    </Border.ChildTransitions>
                </Border>
                <InfoBar
                    x:Name="NotificationBar"
                    MaxWidth="720"
                    Margin="24"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    IsOpen="False" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
