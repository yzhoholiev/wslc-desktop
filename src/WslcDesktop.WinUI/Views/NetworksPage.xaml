<?xml version="1.0" encoding="utf-8"?>

<views:ResourceListPage
    x:Class="WslcDesktop.Views.NetworksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:WslcDesktop.Views"
    xmlns:controls="using:WslcDesktop.Controls"
    xmlns:vm="using:WslcDesktop.ViewModels"
    Background="Transparent">

    <Page.Resources>
        <DataTemplate x:Key="RowTemplate" x:DataType="vm:NetworkItem">
            <controls:ClickableRow Height="56" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ShortId}" FontFamily="{StaticResource MonoFont}"
                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{x:Bind Driver}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{x:Bind Kind}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="3" Text="{x:Bind Created}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <controls:UsageChip Grid.Column="4" ContainerCount="{x:Bind ContainerCount}" Tag="{x:Bind}" Click="OnUsageClick" />
                <Button x:Name="RowActions" Grid.Column="5" Tag="{x:Bind}" Click="OnRemoveClick" IsEnabled="{x:Bind CanRemove}"
                        Style="{StaticResource RowActionButtonStyle}" ToolTipService.ToolTip="Delete network"
                        AutomationProperties.Name="Delete network">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                </Button>
            </controls:ClickableRow>
        </DataTemplate>
    </Page.Resources>

    <views:ResourceListView List="{x:Bind ViewModel}" Title="Networks" SearchPlaceholder="Search networks" ErrorTitle="Could not list networks"
                            ItemTemplate="{StaticResource RowTemplate}">
        <views:ResourceListView.Toolbar>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="OnPruneClick" AutomationProperties.Name="Remove unused">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                        <TextBlock Text="Remove unused" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Command="{x:Bind ViewModel.RefreshCommand}" ToolTipService.ToolTip="Refresh"
                        AutomationProperties.Name="Refresh">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </StackPanel>
        </views:ResourceListView.Toolbar>
        <views:ResourceListView.ColumnHeaders>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <controls:SortHeader Text="NAME" Key="name" Sort="{x:Bind ViewModel.Sort}" />
                <controls:SortHeader Grid.Column="1" Text="DRIVER" Key="driver" Sort="{x:Bind ViewModel.Sort}" />
                <controls:SortHeader Grid.Column="2" Text="KIND" Key="kind" Sort="{x:Bind ViewModel.Sort}" />
                <controls:SortHeader Grid.Column="3" Text="CREATED (UTC)" Key="created" Sort="{x:Bind ViewModel.Sort}" />
                <controls:SortHeader Grid.Column="4" Text="USAGE" Key="usage" Sort="{x:Bind ViewModel.Sort}" />
            </Grid>
        </views:ResourceListView.ColumnHeaders>
    </views:ResourceListView>
</views:ResourceListPage>
