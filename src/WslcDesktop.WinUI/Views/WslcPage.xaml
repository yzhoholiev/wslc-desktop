<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="WslcDesktop.Views.WslcPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WslcDesktop.Controls"
    xmlns:vm="using:WslcDesktop.ViewModels"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,24,32,96" Spacing="16">
            <Grid>
                <StackPanel>
                    <TextBlock Text="WSL containers" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="The wslc session VM, its settings and sessions" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Command="{x:Bind ViewModel.RefreshCommand}" ToolTipService.ToolTip="Refresh"
                        AutomationProperties.Name="Refresh">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </Grid>

            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Session VM" Style="{StaticResource CardTitleStyle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.SessionSettings}" ItemTemplate="{StaticResource KeyValueTemplate}" />
                        <TextBlock Text="wslc reads these when the session starts; stop the runtime for a change to take effect."
                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Spacing="12">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Running VM" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.VmText, Mode=OneWay}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Versions" Style="{StaticResource CardTitleStyle}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Versions}" ItemTemplate="{StaticResource KeyValueTemplate}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Container sessions" Style="{StaticResource CardTitleStyle}" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <controls:SortHeader Text="ID" Key="id" Sort="{x:Bind ViewModel.SessionSort}" />
                        <controls:SortHeader Grid.Column="1" Text="NAME" Key="name" Sort="{x:Bind ViewModel.SessionSort}" />
                        <controls:SortHeader Grid.Column="2" Text="CREATOR PID" Key="pid" Sort="{x:Bind ViewModel.SessionSort}" />
                        <TextBlock Grid.Column="3" Text="ACTIONS" Style="{StaticResource ColumnHeaderStyle}" />
                    </Grid>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Sessions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WslcSessionItem">
                                <Grid ColumnSpacing="12" Height="40">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Id}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind CreatorPid}" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Tag="{x:Bind}" Click="OnSessionShellClick" Style="{StaticResource RowActionButtonStyle}"
                                                ToolTipService.ToolTip="Open session shell" AutomationProperties.Name="Open session shell">
                                            <FontIcon Glyph="&#xE756;" FontSize="14" />
                                        </Button>
                                        <Button Tag="{x:Bind}" Click="OnTerminateSessionClick" Style="{StaticResource RowActionButtonStyle}"
                                                ToolTipService.ToolTip="Terminate session" AutomationProperties.Name="Terminate session">
                                            <FontIcon Glyph="&#xE71A;" FontSize="14" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No active sessions — the container VM is not running." Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Visibility="{x:Bind ViewModel.HasNoSessions, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <Grid>
                        <TextBlock Text="settings.yaml" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right" Command="{x:Bind ViewModel.OpenSettingsCommand}" AutomationProperties.Name="Edit settings.yaml">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                <TextBlock Text="Edit" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.SettingsFilePath}" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.SettingsText, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                               IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
