<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="WslcDesktop.Views.ResourceListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WslcDesktop.Controls"
    xmlns:vm="using:WslcDesktop.ViewModels">

    <Grid Padding="32,24,32,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind List.Summary, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox PlaceholderText="{x:Bind SearchPlaceholder, Mode=OneWay}"
                     Text="{x:Bind List.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ContentPresenter Grid.Column="1" HorizontalAlignment="Right" Content="{x:Bind Toolbar, Mode=OneWay}" />
        </Grid>

        <StackPanel Grid.Row="2" Spacing="8">
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind List.IsBusy, Mode=OneWay}" />
            <InfoBar IsOpen="{x:Bind List.HasLoadError, Mode=OneWay}" Severity="Error" Title="{x:Bind ErrorTitle, Mode=OneWay}"
                     Message="{x:Bind List.LoadError, Mode=OneWay}" IsClosable="False" />
        </StackPanel>

        <Grid Grid.Row="3" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="160" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Padding="16,10,12,10" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <ContentPresenter Content="{x:Bind ColumnHeaders, Mode=OneWay}" HorizontalContentAlignment="Stretch" />
                    </Border>

                    <ListView
                        x:Name="Rows"
                        Grid.Row="1"
                        ItemsSource="{x:Bind List.Items, Mode=OneWay}"
                        ItemTemplate="{x:Bind ItemTemplate, Mode=OneWay}"
                        SelectionMode="Single"
                        IsItemClickEnabled="True"
                        ItemClick="OnItemClick"
                        SelectionChanged="OnSelectionChanged">
                        <!-- The default add/delete transition fades a row out and in again whenever its item is replaced or moves -->
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection>
                                <ContentThemeTransition />
                                <ReorderThemeTransition />
                                <EntranceThemeTransition IsStaggeringEnabled="False" />
                            </TransitionCollection>
                        </ListView.ItemContainerTransitions>
                    </ListView>

                    <controls:EmptyState
                        Grid.Row="1"
                        Visibility="{x:Bind List.IsEmpty, Mode=OneWay}"
                        Glyph="{x:Bind List.Empty.Glyph, Mode=OneWay}"
                        Title="{x:Bind List.Empty.Title, Mode=OneWay}"
                        Message="{x:Bind List.Empty.Message, Mode=OneWay}"
                        ActionText="{x:Bind List.Empty.ActionText, Mode=OneWay}"
                        IsActionEnabled="{x:Bind vm:Bindings.CanRunEmptyAction(List.Empty, List.IsBusy), Mode=OneWay}"
                        ActionClick="OnEmptyActionClick" />
                </Grid>
            </Border>

            <controls:InspectPanel
                Grid.Row="1"
                Height="340"
                Visibility="{x:Bind List.IsDetailsOpen, Mode=OneWay}"
                Title="{x:Bind List.DetailsTitle, Mode=OneWay}"
                Subtitle="{x:Bind List.DetailsSubtitle, Mode=OneWay}"
                Text="{x:Bind List.InspectText, Mode=OneWay}"
                CloseRequested="OnDetailsCloseRequested" />
        </Grid>
    </Grid>
</UserControl>
