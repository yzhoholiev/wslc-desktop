<?xml version="1.0" encoding="utf-8"?>

<views:ResourceListPage
    x:Class="WslcDesktop.Views.ImagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:WslcDesktop.Views"
    xmlns:controls="using:WslcDesktop.Controls"
    xmlns:vm="using:WslcDesktop.ViewModels"
    Background="Transparent">

    <Page.Resources>
        <DataTemplate x:Key="RowTemplate" x:DataType="vm:ImageItem">
            <controls:ClickableRow Height="48" ColumnSpacing="12" ColumnDefinitions="3*, 110, 1.2*, 1.2*, 72">
                <controls:ClickableRow.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Run a container" Tag="{x:Bind}" Click="OnRunClick">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE768;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Copy reference" Tag="{x:Bind Reference}" Click="OnCopyClick">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8C8;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Copy ID" Tag="{x:Bind Id}" Click="OnCopyClick" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Delete image" Tag="{x:Bind}" Click="OnRemoveClick">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74D;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </controls:ClickableRow.ContextFlyout>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{x:Bind Repository}" TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" ToolTipService.ToolTip="{x:Bind Reference}" />
                        <Border Style="{StaticResource PillStyle}" Background="{ThemeResource ImagesBadgeBackgroundBrush}"
                                Visibility="{x:Bind HasTag}">
                            <TextBlock Text="{x:Bind Tag}" Style="{StaticResource PillTextStyle}" FontFamily="{StaticResource MonoFont}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ShortId}" FontFamily="{StaticResource MonoFont}"
                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="{x:Bind Size}" />
                    <Grid Height="3" MaxWidth="72" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{x:Bind vm:Bindings.Filled(SizeShare)}" />
                            <ColumnDefinition Width="{x:Bind vm:Bindings.Remaining(SizeShare)}" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="2" CornerRadius="1.5" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Border CornerRadius="1.5" Background="{ThemeResource ImagesBadgeBrush}" />
                    </Grid>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{x:Bind Created}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <controls:UsageChip Grid.Column="3" ContainerCount="{x:Bind ContainerCount}" Tag="{x:Bind}" Click="OnUsageClick" />
                <StackPanel x:Name="RowActions" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Tag="{x:Bind}" Click="OnRunClick" Style="{StaticResource RowActionButtonStyle}"
                            ToolTipService.ToolTip="Run a container" AutomationProperties.Name="Run a container">
                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                    </Button>
                    <Button x:Name="RowMenu" Style="{StaticResource RowActionButtonStyle}" ToolTipService.ToolTip="More actions"
                            AutomationProperties.Name="More actions">
                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                    </Button>
                </StackPanel>
            </controls:ClickableRow>
        </DataTemplate>
    </Page.Resources>

    <views:ResourceListView List="{x:Bind ViewModel}" Title="Images" SearchPlaceholder="Search images" ErrorTitle="Could not list images"
                            ItemTemplate="{StaticResource RowTemplate}" DeleteRequested="OnDeleteRequested">
        <views:ResourceListView.Toolbar>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox Width="280" PlaceholderText="Image to pull, e.g. nginx:alpine"
                             Text="{x:Bind ViewModel.PullReference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnPullKeyDown" />
                    <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.PullCommand}" AutomationProperties.Name="Pull">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE896;" FontSize="14" />
                            <TextBlock Text="Pull" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <DropDownButton AutomationProperties.Name="Prune">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            <TextBlock Text="Prune" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Text="Remove dangling images" Click="OnPruneDanglingClick" />
                                <MenuFlyoutItem Text="Remove all unused images" Click="OnPruneAllClick" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button Style="{StaticResource IconButtonStyle}" Command="{x:Bind ViewModel.RefreshCommand}" ToolTipService.ToolTip="Refresh"
                            AutomationProperties.Name="Refresh">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F5" />
                        </Button.KeyboardAccelerators>
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </views:ResourceListView.Toolbar>
        <views:ResourceListView.ColumnHeaders>
            <Grid ColumnSpacing="12" ColumnDefinitions="3*, 110, 1.2*, 1.2*, 72">
                <controls:SortHeader Text="IMAGE" Key="image" Sort="{x:Bind ViewModel.Sort}" />
                <controls:SortHeader Grid.Column="1" Text="SIZE" Key="size" Sort="{x:Bind ViewModel.Sort}" />
                <controls:SortHeader Grid.Column="2" Text="CREATED" Key="created" Sort="{x:Bind ViewModel.Sort}" />
                <controls:SortHeader Grid.Column="3" Text="USAGE" Key="usage" Sort="{x:Bind ViewModel.Sort}" />
            </Grid>
        </views:ResourceListView.ColumnHeaders>
    </views:ResourceListView>
</views:ResourceListPage>
