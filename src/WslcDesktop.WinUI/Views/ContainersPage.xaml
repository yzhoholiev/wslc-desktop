<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="WslcDesktop.Views.ContainersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WslcDesktop.Controls"
    xmlns:vm="using:WslcDesktop.ViewModels"
    Background="Transparent">

    <Grid Padding="32,24,32,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Containers" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox PlaceholderText="Search by name, image or ID" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <CheckBox Grid.Column="1" Content="Show stopped" IsChecked="{x:Bind ViewModel.ShowStopped, Mode=TwoWay}" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                <Button Click="OnStopAllClick" IsEnabled="{x:Bind vm:Bindings.CanAct(ViewModel.HasRunning, ViewModel.IsBusy), Mode=OneWay}"
                        AutomationProperties.Name="Stop all">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE71A;" FontSize="14" />
                        <TextBlock Text="Stop all" />
                    </StackPanel>
                </Button>
                <Button Click="OnPruneClick" AutomationProperties.Name="Remove stopped">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                        <TextBlock Text="Remove stopped" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Command="{x:Bind ViewModel.RefreshCommand}" ToolTipService.ToolTip="Refresh"
                        AutomationProperties.Name="Refresh">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <ProgressBar Grid.Row="2" IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

        <Grid Grid.Row="3" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="160" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Padding="16,10,12,10" ColumnSpacing="12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="152" />
                        </Grid.ColumnDefinitions>
                        <controls:SortHeader Text="NAME" Key="name" Sort="{x:Bind ViewModel.Sort}" />
                        <controls:SortHeader Grid.Column="1" Text="IMAGE" Key="image" Sort="{x:Bind ViewModel.Sort}" />
                        <controls:SortHeader Grid.Column="2" Text="STATUS" Key="status" Sort="{x:Bind ViewModel.Sort}" />
                        <controls:SortHeader Grid.Column="3" Text="PORTS" Key="ports" Sort="{x:Bind ViewModel.Sort}" />
                        <controls:SortHeader Grid.Column="4" Text="CPU" Key="cpu" Sort="{x:Bind ViewModel.Sort}" />
                        <controls:SortHeader Grid.Column="5" Text="MEMORY" Key="memory" Sort="{x:Bind ViewModel.Sort}" />
                    </Grid>

                    <ListView
                        x:Name="ContainerList"
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.Items}"
                        SelectionMode="Single"
                        SelectionChanged="OnSelectionChanged">
                        <!-- The default add/delete transition fades a row out and in again whenever its item is replaced or moves -->
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection>
                                <ContentThemeTransition />
                                <ReorderThemeTransition />
                                <EntranceThemeTransition IsStaggeringEnabled="False" />
                            </TransitionCollection>
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ContainerItem">
                                <controls:ClickableRow Height="56" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="84" />
                                        <ColumnDefinition Width="152" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind ShortId}" FontFamily="{StaticResource MonoFont}"
                                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                    <HyperlinkButton Grid.Column="1" Style="{StaticResource LinkTextButtonStyle}" Tag="{x:Bind}" Click="OnImageClick"
                                                     ToolTipService.ToolTip="Show image">
                                        <TextBlock Text="{x:Bind Image}" TextTrimming="CharacterEllipsis" />
                                    </HyperlinkButton>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                                        <Border Style="{x:Bind vm:Bindings.StatePillStyle(State), Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                         Style="{x:Bind vm:Bindings.StateDotStyle(State), Mode=OneWay}" />
                                                <TextBlock Text="{x:Bind vm:Labels.StateLabel(State), Mode=OneWay}" Style="{StaticResource PillTextStyle}" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{x:Bind Status, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                                   TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                    <controls:PortChips Grid.Column="3" Ports="{x:Bind Ports, Mode=OneWay}" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind Cpu, Mode=OneWay}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind Memory, Mode=OneWay}" VerticalAlignment="Center" />
                                    <StackPanel x:Name="RowActions" Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Tag="{x:Bind}" Click="OnStartStopClick" Style="{StaticResource RowActionButtonStyle}"
                                                ToolTipService.ToolTip="{x:Bind vm:Labels.StartStopLabel(IsRunning), Mode=OneWay}"
                                                AutomationProperties.Name="{x:Bind vm:Labels.StartStopLabel(IsRunning), Mode=OneWay}">
                                            <FontIcon Glyph="{x:Bind vm:Bindings.StartStopGlyph(IsRunning), Mode=OneWay}" FontSize="14" />
                                        </Button>
                                        <Button Tag="{x:Bind}" Click="OnRestartClick" Style="{StaticResource RowActionButtonStyle}"
                                                ToolTipService.ToolTip="Restart" AutomationProperties.Name="Restart"
                                                IsEnabled="{x:Bind IsRunning, Mode=OneWay}">
                                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                        </Button>
                                        <Button Tag="{x:Bind}" Click="OnShellClick" Style="{StaticResource RowActionButtonStyle}"
                                                ToolTipService.ToolTip="Open shell" AutomationProperties.Name="Open shell"
                                                IsEnabled="{x:Bind IsRunning, Mode=OneWay}">
                                            <FontIcon Glyph="&#xE756;" FontSize="14" />
                                        </Button>
                                        <Button Tag="{x:Bind}" Click="OnRemoveClick" Style="{StaticResource RowActionButtonStyle}"
                                                ToolTipService.ToolTip="Delete" AutomationProperties.Name="Delete">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                        </Button>
                                    </StackPanel>
                                </controls:ClickableRow>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <controls:EmptyState
                        Grid.Row="1"
                        Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                        Glyph="{x:Bind ViewModel.Empty.Glyph, Mode=OneWay}"
                        Title="{x:Bind ViewModel.Empty.Title, Mode=OneWay}"
                        Message="{x:Bind ViewModel.Empty.Message, Mode=OneWay}"
                        ActionText="{x:Bind ViewModel.Empty.ActionText, Mode=OneWay}"
                        IsActionEnabled="{x:Bind vm:Bindings.CanRunEmptyAction(ViewModel.Empty, ViewModel.IsBusy), Mode=OneWay}"
                        ActionClick="OnEmptyActionClick" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Height="380" Style="{StaticResource CardStyle}" Padding="0" Visibility="{x:Bind ViewModel.IsDetailsOpen, Mode=OneWay}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Padding="16,12,8,0">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.Selected.Name, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Image" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Button Style="{StaticResource ChipButtonStyle}" Content="{x:Bind ViewModel.Selected.Image, Mode=OneWay}"
                                            Click="OnDetailsImageClick" ToolTipService.ToolTip="Show image" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6"
                                            Visibility="{x:Bind vm:Bindings.VisibleWhenAny(ViewModel.Selected.Mounts), Mode=OneWay}">
                                    <TextBlock Text="Volumes" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <controls:LinkList Names="{x:Bind ViewModel.Selected.Mounts, Mode=OneWay}" LinkClick="OnVolumeLinkClick" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource RowActionButtonStyle}"
                                Command="{x:Bind ViewModel.CloseDetailsCommand}" ToolTipService.ToolTip="Close" AutomationProperties.Name="Close">
                            <FontIcon Glyph="&#xE711;" FontSize="14" />
                        </Button>
                    </Grid>

                    <Pivot Grid.Row="1">
                        <PivotItem Header="Logs">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="20">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Tail" VerticalAlignment="Center" />
                                        <NumberBox Value="{x:Bind ViewModel.Logs.Tail, Mode=TwoWay}" Minimum="1" Maximum="100000" SmallChange="100" Width="110"
                                                   VerticalAlignment="Center" AutomationProperties.Name="Tail" />
                                    </StackPanel>
                                    <ToggleSwitch IsOn="{x:Bind ViewModel.Logs.Follow, Mode=TwoWay}" OnContent="Follow" OffContent="Follow" MinWidth="0"
                                                  VerticalAlignment="Center" AutomationProperties.Name="Follow" />
                                    <ToggleSwitch IsOn="{x:Bind ViewModel.Logs.ShowTimestamps, Mode=TwoWay}" OnContent="Timestamps" OffContent="Timestamps"
                                                  MinWidth="0" VerticalAlignment="Center" AutomationProperties.Name="Timestamps" />
                                    <Button Style="{StaticResource IconButtonStyle}" VerticalAlignment="Center"
                                            Command="{x:Bind ViewModel.Logs.RefreshCommand}" ToolTipService.ToolTip="Reload logs"
                                            AutomationProperties.Name="Reload logs">
                                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    </Button>
                                </StackPanel>
                                <ScrollViewer x:Name="LogsScroller" Grid.Row="1" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto">
                                    <controls:LogView SizeChanged="OnLogsSizeChanged" Text="{x:Bind ViewModel.Logs.Text, Mode=OneWay}"
                                                      ShowTimestamps="{x:Bind ViewModel.Logs.ShowTimestamps, Mode=OneWay}" Padding="0,0,0,12" />
                                </ScrollViewer>
                            </Grid>
                        </PivotItem>
                        <PivotItem Header="Inspect">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto">
                                <controls:JsonView Text="{x:Bind ViewModel.InspectText, Mode=OneWay}" Padding="0,0,0,12" />
                            </ScrollViewer>
                        </PivotItem>
                    </Pivot>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
