<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="WslcDesktop.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WslcDesktop.Controls"
    xmlns:vm="using:WslcDesktop.ViewModels"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,24,32,96" Spacing="16">

            <Grid>
                <StackPanel Spacing="4">
                    <TextBlock Text="Dashboard" Style="{StaticResource TitleTextBlockStyle}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Style="{x:Bind vm:Bindings.RuntimeDotStyle(ViewModel.IsRunning), Mode=OneWay}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Spacing="8">
                    <Button
                        Click="OnStopRuntimeClick"
                        Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay}"
                        IsEnabled="{x:Bind vm:Bindings.Not(ViewModel.IsBusy), Mode=OneWay}"
                        ToolTipService.ToolTip="Shut down this app's wslc session and release its VM"
                        AutomationProperties.Name="Stop runtime">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7E8;" FontSize="14" />
                            <TextBlock Text="Stop runtime" />
                        </StackPanel>
                    </Button>
                    <Button
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.StartRuntimeCommand}"
                        Visibility="{x:Bind ViewModel.IsStopped, Mode=OneWay}"
                        IsEnabled="{x:Bind vm:Bindings.Not(ViewModel.IsBusy), Mode=OneWay}"
                        ToolTipService.ToolTip="Start this app's wslc session"
                        AutomationProperties.Name="Start runtime">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                            <TextBlock Text="Start runtime" />
                        </StackPanel>
                    </Button>
                    <DropDownButton AutomationProperties.Name="Actions">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE712;" FontSize="14" />
                            <TextBlock Text="Actions" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem
                                    Text="Clean up…"
                                    Click="OnCleanupClick"
                                    IsEnabled="{x:Bind vm:Bindings.CanAct(ViewModel.IsRunning, ViewModel.IsBusy), Mode=OneWay}"
                                    ToolTipService.ToolTip="Remove stopped containers and unused images, networks and volumes">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xEA99;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Stop all containers…" Click="OnStopAllClick"
                                                IsEnabled="{x:Bind vm:Bindings.CanAct(ViewModel.IsRunning, ViewModel.IsBusy), Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE71A;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <!-- Never disabled: shutting down WSL is what ends a hung runtime operation -->
                                <MenuFlyoutItem Text="Shut down WSL…" Click="OnShutdownClick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE756;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Edit wslc settings" Command="{x:Bind ViewModel.OpenWslcSettingsCommand}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE713;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button Style="{StaticResource IconButtonStyle}" Command="{x:Bind ViewModel.RefreshCommand}" ToolTipService.ToolTip="Refresh"
                            AutomationProperties.Name="Refresh">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>

            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

            <InfoBar
                IsOpen="{x:Bind ViewModel.IsStopped, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsStopped, Mode=OneWay}"
                IsClosable="False"
                Severity="Informational"
                Title="Container runtime stopped"
                Message="No wslc session is running, so the VM is not using any resources." />

            <InfoBar
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}"
                IsClosable="False"
                Severity="Error"
                Title="{x:Bind ViewModel.ErrorTitle, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button
                        Content="Update WSL"
                        Command="{x:Bind ViewModel.UpdateWslCommand}"
                        Visibility="{x:Bind ViewModel.IsWslcMissing, Mode=OneWay}" />
                </InfoBar.ActionButton>
                <HyperlinkButton
                    Content="About WSL containers"
                    Command="{x:Bind ViewModel.OpenWslcDocumentationCommand}"
                    Visibility="{x:Bind ViewModel.IsWslcMissing, Mode=OneWay}"
                    Margin="0,0,0,8" />
            </InfoBar>

            <!-- Inventory -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <controls:StatCard Title="Containers" Glyph="&#xE7B8;" Tag="containers" Click="OnStatCardClick" AutomationProperties.Name="Open containers"
                                   BadgeBrush="{ThemeResource ContainersBadgeBrush}" BadgeBackground="{ThemeResource ContainersBadgeBackgroundBrush}"
                                   Value="{x:Bind ViewModel.ContainersCount, Mode=OneWay}" Detail="{x:Bind ViewModel.ContainersDetail, Mode=OneWay}"
                                   ShowDot="True" DotStyle="{x:Bind vm:Bindings.RuntimeDotStyle(ViewModel.HasRunningContainers), Mode=OneWay}" />
                <controls:StatCard Grid.Column="1" Title="Images" Glyph="&#xE8B9;" Tag="images" Click="OnStatCardClick" AutomationProperties.Name="Open images"
                                   BadgeBrush="{ThemeResource ImagesBadgeBrush}" BadgeBackground="{ThemeResource ImagesBadgeBackgroundBrush}"
                                   Value="{x:Bind ViewModel.ImagesCount, Mode=OneWay}" Detail="{x:Bind ViewModel.ImagesDetail, Mode=OneWay}" />
                <controls:StatCard Grid.Column="2" Title="Volumes" Glyph="&#xEDA2;" Tag="volumes" Click="OnStatCardClick"
                                   AutomationProperties.Name="Open volumes"
                                   BadgeBrush="{ThemeResource VolumesBadgeBrush}" BadgeBackground="{ThemeResource VolumesBadgeBackgroundBrush}"
                                   Value="{x:Bind ViewModel.VolumesCount, Mode=OneWay}" Detail="{x:Bind ViewModel.VolumesDetail, Mode=OneWay}" />
                <controls:StatCard Grid.Column="3" Title="Networks" Glyph="&#xE968;" Tag="networks" Click="OnStatCardClick"
                                   AutomationProperties.Name="Open networks"
                                   BadgeBrush="{ThemeResource NetworksBadgeBrush}" BadgeBackground="{ThemeResource NetworksBadgeBackgroundBrush}"
                                   Value="{x:Bind ViewModel.NetworksCount, Mode=OneWay}" Detail="{x:Bind ViewModel.NetworksDetail, Mode=OneWay}" />
            </Grid>

            <TextBlock Text="Container VM resources" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <controls:MetricCard Title="CPU" Value="{x:Bind ViewModel.CpuValue, Mode=OneWay}"
                                     Caption="{x:Bind ViewModel.CpuCaption, Mode=OneWay}" History="{x:Bind ViewModel.CpuHistory, Mode=OneWay}"
                                     HasHistory="{x:Bind ViewModel.HasHistory, Mode=OneWay}" />

                <controls:MetricCard Grid.Column="1" Title="Memory" Value="{x:Bind ViewModel.MemoryValue, Mode=OneWay}"
                                     Caption="{x:Bind ViewModel.MemoryCaption, Mode=OneWay}" History="{x:Bind ViewModel.MemoryHistory, Mode=OneWay}"
                                     HasHistory="{x:Bind ViewModel.HasHistory, Mode=OneWay}" />

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Container storage" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.StorageValue, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.StorageCaption, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Row="3" Margin="0,10,0,0" Spacing="8" VerticalAlignment="Bottom"
                                    Visibility="{x:Bind ViewModel.HasStorage, Mode=OneWay}">
                            <Border Height="10" CornerRadius="5" Background="{ThemeResource ControlStrongFillColorDisabledBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{x:Bind vm:Bindings.Filled(ViewModel.StorageImagesShare), Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind vm:Bindings.Remaining(ViewModel.StorageImagesShare), Mode=OneWay}" />
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="5,0,0,5" Background="{ThemeResource ImagesBadgeBrush}" />
                                </Grid>
                            </Border>
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" VerticalAlignment="Center"
                                                   Fill="{ThemeResource ImagesBadgeBrush}" />
                                        <TextBlock Text="Images" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6" ToolTipService.ToolTip="Containers, volumes and build cache">
                                        <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" VerticalAlignment="Center"
                                                   Fill="{ThemeResource ControlStrongFillColorDisabledBrush}" />
                                        <TextBlock Text="Other" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <HyperlinkButton HorizontalAlignment="Right" Padding="4,0" Content="Clean up…" Click="OnCleanupClick"
                                                 IsEnabled="{x:Bind vm:Bindings.CanAct(ViewModel.IsRunning, ViewModel.IsBusy), Mode=OneWay}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <Grid>
                        <TextBlock Text="Busiest containers" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="4"
                                    Visibility="{x:Bind vm:Bindings.CollapsedWhen(ViewModel.HasTopContainers), Mode=OneWay}">
                            <TextBlock Text="No running containers ·" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <HyperlinkButton Padding="2,0" Content="Go to containers" Tag="containers" Click="OnStatCardClick" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.HasTopContainers, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.4*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="NAME" Style="{StaticResource ColumnHeaderStyle}" />
                        <TextBlock Grid.Column="1" Text="IMAGE" Style="{StaticResource ColumnHeaderStyle}" />
                        <TextBlock Grid.Column="2" Text="CPU" Style="{StaticResource ColumnHeaderStyle}" />
                        <TextBlock Grid.Column="3" Text="MEMORY" Style="{StaticResource ColumnHeaderStyle}" />
                    </Grid>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.TopContainers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ContainerUsage">
                                <Grid ColumnSpacing="12" Padding="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="1.4*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Image}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Grid Grid.Column="2" Height="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{x:Bind vm:Bindings.Filled(CpuShare)}" />
                                            <ColumnDefinition Width="{x:Bind vm:Bindings.Remaining(CpuShare)}" />
                                        </Grid.ColumnDefinitions>
                                        <Border CornerRadius="4" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.28" />
                                        <TextBlock Grid.ColumnSpan="2" Margin="6,0" VerticalAlignment="Center" Text="{x:Bind Cpu}" />
                                    </Grid>
                                    <Grid Grid.Column="3" Height="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{x:Bind vm:Bindings.Filled(MemoryShare)}" />
                                            <ColumnDefinition Width="{x:Bind vm:Bindings.Remaining(MemoryShare)}" />
                                        </Grid.ColumnDefinitions>
                                        <Border CornerRadius="4" Background="{ThemeResource VolumesBadgeBrush}" Opacity="0.28" />
                                        <TextBlock Grid.ColumnSpan="2" Margin="6,0" VerticalAlignment="Center" Text="{x:Bind Memory}" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
