<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="WslcDesktop.Views.WslPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WslcDesktop.Controls"
    xmlns:models="using:WslcDesktop.Models"
    xmlns:vm="using:WslcDesktop.ViewModels"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,24,32,96" Spacing="16">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Windows Subsystem for Linux" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Distributions and platform settings" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Command="{x:Bind ViewModel.RefreshCommand}" ToolTipService.ToolTip="Refresh"
                        AutomationProperties.Name="Refresh">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </Grid>

            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Platform" Style="{StaticResource CardTitleStyle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Versions}" ItemTemplate="{StaticResource KeyValueTemplate}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Manage" Style="{StaticResource CardTitleStyle}" />
                        <!-- Never disabled: shutting down WSL is what ends a hung runtime operation -->
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnShutdownClick" AutomationProperties.Name="Shut down WSL">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7E8;" FontSize="14" />
                                <TextBlock Text="Shut down WSL" />
                            </StackPanel>
                        </Button>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{x:Bind ViewModel.UpdateCommand}"
                                    AutomationProperties.Name="Update WSL">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE895;" FontSize="14" />
                                    <TextBlock Text="Update WSL" />
                                </StackPanel>
                            </Button>
                            <CheckBox Grid.Column="1" Content="Pre-release" MinWidth="0" IsChecked="{x:Bind ViewModel.UsePreRelease, Mode=TwoWay}" />
                        </Grid>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{x:Bind ViewModel.OpenSettingsAppCommand}"
                                IsEnabled="{x:Bind ViewModel.IsSettingsAppInstalled}" AutomationProperties.Name="Open WSL Settings">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE713;" FontSize="14" />
                                <TextBlock Text="Open WSL Settings" />
                            </StackPanel>
                        </Button>
                        <TextBlock
                            Text="Updating may prompt for administrator approval."
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Distributions" Style="{StaticResource CardTitleStyle}" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <controls:SortHeader Text="NAME" Key="name" Sort="{x:Bind ViewModel.DistroSort}" />
                        <controls:SortHeader Grid.Column="1" Text="STATE" Key="state" Sort="{x:Bind ViewModel.DistroSort}" />
                        <controls:SortHeader Grid.Column="2" Text="WSL" Key="version" Sort="{x:Bind ViewModel.DistroSort}" />
                        <TextBlock Grid.Column="3" Text="ACTIONS" Style="{StaticResource ColumnHeaderStyle}" />
                    </Grid>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Distros}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:WslDistro">
                                <Grid ColumnSpacing="12" Height="40">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <Border
                                            Padding="6,1"
                                            CornerRadius="4"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            Visibility="{x:Bind IsDefault}">
                                            <TextBlock Text="Default" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Style="{x:Bind vm:Bindings.DistroStateDotStyle(State)}" />
                                        <TextBlock Text="{x:Bind State}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind Version}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Tag="{x:Bind}" Click="OnDistroTerminalClick" Style="{StaticResource RowActionButtonStyle}"
                                                ToolTipService.ToolTip="Open terminal" AutomationProperties.Name="Open terminal">
                                            <FontIcon Glyph="&#xE756;" FontSize="14" />
                                        </Button>
                                        <Button Tag="{x:Bind}" Click="OnSetDefaultClick" Style="{StaticResource RowActionButtonStyle}"
                                                ToolTipService.ToolTip="Set as default" AutomationProperties.Name="Set as default"
                                                IsEnabled="{x:Bind vm:Bindings.Not(IsDefault)}">
                                            <FontIcon Glyph="&#xE734;" FontSize="14" />
                                        </Button>
                                        <Button Tag="{x:Bind}" Click="OnTerminateDistroClick" Style="{StaticResource RowActionButtonStyle}"
                                                ToolTipService.ToolTip="Terminate" AutomationProperties.Name="Terminate" IsEnabled="{x:Bind IsRunning}">
                                            <FontIcon Glyph="&#xE71A;" FontSize="14" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No distributions installed." Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Visibility="{x:Bind ViewModel.HasNoDistros, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <Grid>
                        <TextBlock Text=".wslconfig" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right" Command="{x:Bind ViewModel.OpenWslConfigCommand}" AutomationProperties.Name="Edit .wslconfig">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                <TextBlock Text="Edit" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="Applies to WSL distributions, not to the container VM, which takes its settings from wslc." Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.WslConfigText, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                               IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
