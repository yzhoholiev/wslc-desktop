<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>WslcDesktop</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- File properties; GitVersion stamps the version from the latest v* tag and the commits since -->
  <PropertyGroup>
    <Authors>Yurii Zhoholiev</Authors>
    <Company>Yurii Zhoholiev</Company>
    <Copyright>Copyright (c) 2026 Yurii Zhoholiev</Copyright>
    <!-- GitVersion's informational version already ends with the commit -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GitVersion.MsBuild" PrivateAssets="all" />
  </ItemGroup>

  <!-- net10.0-windows alone means Windows 7 to the platform analyzer; the libraries declare the app's minimum, Windows 10 2004, instead -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'WslcDesktop.WinUI'">
    <GenerateSupportedOSPlatformAttribute>false</GenerateSupportedOSPlatformAttribute>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' != 'WslcDesktop.WinUI'">
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows10.0.19041.0</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Native AOT publishing, for the executables; set here rather than in a .targets file because the SDK reads PublishAot before importing those -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'WslcDesktop.WinUI' Or '$(MSBuildProjectName)' == 'WslcDesktop.Launcher'">
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <!-- CsWin32, for the projects that list Win32 APIs in a NativeMethods.txt -->
  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)\NativeMethods.txt')">
    <!-- CsWin32 must generate before compile, and without runtime marshalling, to stay AOT-safe -->
    <CsWin32RunAsBuildTask>true</CsWin32RunAsBuildTask>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\NativeMethods.txt')">
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)NativeMethods.json" />
  </ItemGroup>

</Project>
